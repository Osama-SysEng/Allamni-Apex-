# Allamni v4.0 Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://allamni_user:allamni_password@localhost:5432/allamni
REDIS_URL=redis://localhost:6379

# AI Provider Configuration
AI_PROVIDER=mock  # Options: mock, gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
ENCRYPTION_KEY=your_encryption_key_here_change_in_production

# Service URLs (for development)
AUTH_URL=http://localhost:8001
LEARNING_URL=http://localhost:8002
AI_URL=http://localhost:8003
INTEGRATION_URL=http://localhost:8004
INSTITUTION_URL=http://localhost:8005

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Odoo Integration (Optional)
ODOO_URL=https://your-odoo-instance.com
ODOO_API_KEY=your_odoo_api_key
ODOO_DATABASE=your_odoo_database

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_optional

# Flutter App Configuration
API_BASE_URL=http://localhost:8000
API_VERSION=/api/v1
AUTH_BASE_URL=http://localhost:8001
AI_BASE_URL=http://localhost:8003
INSTITUTION_BASE_URL=http://localhost:8005

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_OFFLINE_MODE=true
ENABLE_NOTIFICATIONS=true
ENABLE_PHASE5_CHATBOT=true