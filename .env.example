# ═══════════════════════════════════════
# Allamni v4.0 Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════

# ═══════════════════════════════════════
# AI PROVIDER CONFIGURATION (REQUIRED)
# ═══════════════════════════════════════
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Get from: https://aistudio.google.com/app/apikey
# Free tier available — no credit card required

GEMINI_MODEL=gemini-1.5-pro
# Options: gemini-1.5-pro (quality) | gemini-1.5-flash (speed + cost)

# ═══════════════════════════════════════
# ODOO ERP INTEGRATION (OPTIONAL)
# ═══════════════════════════════════════
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=admin@yourdomain.com
ODOO_PASSWORD=your-odoo-password

# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════
DATABASE_URL=postgresql://user:pass@localhost:5432/allamni
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ═══════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════
ENVIRONMENT=production
# Options: production | development | test
# MockAIProvider ONLY allowed in test/development

# ═══════════════════════════════════════
# JWT SECURITY
# ═══════════════════════════════════════
JWT_SECRET=generate-a-very-long-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════
# SERVICE URLs (for development)
# ═══════════════════════════════════════
AUTH_URL=http://localhost:8001
LEARNING_URL=http://localhost:8002
AI_URL=http://localhost:8003
INTEGRATION_URL=http://localhost:8004
INSTITUTION_URL=http://localhost:8005

# ═══════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ═══════════════════════════════════════
# Monitoring & Logging
# ═══════════════════════════════════════
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_optional

# ═══════════════════════════════════════
# Flutter App Configuration
# ═══════════════════════════════════════
API_BASE_URL=http://localhost:8000
API_VERSION=/api/v1
AUTH_BASE_URL=http://localhost:8001
AI_BASE_URL=http://localhost:8003
INSTITUTION_BASE_URL=http://localhost:8005

# ═══════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════
ENABLE_VOICE_INPUT=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_OFFLINE_MODE=true
ENABLE_NOTIFICATIONS=true
ENABLE_PHASE5_CHATBOT=true